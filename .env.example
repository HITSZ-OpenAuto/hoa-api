# ─── 运行环境 ─────────────────────────────────────────
HOA_HOST=0.0.0.0
HOA_PORT=8099
HOA_DB_PATH=/root/hoa-api/data/hoa.db

# ─── 对外地址 ─────────────────────────────────────────
HOA_SITE_ORIGIN=https://hoa.moe
HOA_API_BASE_PATH=/api/v1
HOA_MCP_PATH=/mcp

# ─── 限流与跨域 ───────────────────────────────────────
HOA_RATE_LIMIT_PER_MIN=60
HOA_CORS_ORIGINS=*

# ─── 数据同步 ─────────────────────────────────────────
HOA_SYNC_INTERVAL_SEC=21600
HOA_SYNC_PLANS=1
HOA_SYNC_MATERIALS=1

# ─── GitHub ──────────────────────────────────────────
# 生成：https://github.com/settings/tokens
# 需要 public_repo 读权限；没有 token 时同步会受限于 60 次/小时 的匿名配额
GITHUB_TOKEN=
