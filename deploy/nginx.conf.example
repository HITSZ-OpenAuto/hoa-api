# HOA API 的 nginx 虚拟主机示例。
#
# 用法：
#   1. 把 api.hoa.moe 换成实际域名
#   2. 证书路径指向 certbot 签发的证书
#   3. 放到 /etc/nginx/conf.d/hoa-api.conf 后 `nginx -t && systemctl reload nginx`
#
# MCP 的 Streamable HTTP 需要 SSE 流式响应，务必关闭代理缓冲。

server {
    listen 80;
    listen [::]:80;
    server_name api.hoa.moe;

    root /var/www/acme;

    location ^~ /.well-known/acme-challenge/ {
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.hoa.moe;

    ssl_certificate     /etc/letsencrypt/live/api.hoa.moe/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.hoa.moe/privkey.pem;
    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # MCP / SSE 需要长连接
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    chunked_transfer_encoding on;

    client_max_body_size 4m;

    # REST API
    location /api/ {
        proxy_pass http://127.0.0.1:8099;
    }

    # MCP Streamable HTTP
    location = /mcp {
        proxy_pass http://127.0.0.1:8099/mcp;
    }

    location / {
        proxy_pass http://127.0.0.1:8099;
    }
}
